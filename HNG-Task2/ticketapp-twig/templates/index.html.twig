{% extends 'base.html.twig' %}

{# --- 1. LIST VIEW TEMPLATE --- #}
{% block body_list %}
    <div id="view-list" class="view" style="display: block;">
        <h2>Open Tickets</h2>
        
        {# This section is now just a static template structure #}
        <div id="ticket-list-container">
            {# 
              JavaScript will dynamically insert the list items here. 
              The following is a placeholder or a template for one item.
            #}
            <div class="ticket-item-template" style="display: none;">
                <div class="ticket-title" data-bind="title"></div>
                <div class="ticket-meta">
                    <span class="status-badge" data-bind="status-badge"></span>
                    <span class="date" data-bind="createdAt"></span>
                </div>
            </div>

            <p id="no-tickets-message" style="display: none;">No open tickets found. Create a new one!</p>

        </div>
    </div>
{% endblock %}


{# --- 2. NEW TICKET VIEW TEMPLATE --- #}
{% block body_new %}
    <div id="view-new" class="view" style="display: none;">
        <h2>Create New Ticket</h2>

        <form id="new-ticket-form" class="new-ticket-form">
            <div class="form-group">
                <label for="title">Title (Subject)</label>
                <input type="text" id="title" name="title" required maxlength="100">
            </div>
            
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="8" required></textarea>
            </div>

            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority">
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                </select>
            </div>
            
            <button type="submit" class="btn-primary">Submit Ticket</button>
        </form>
    </div>
{% endblock %}