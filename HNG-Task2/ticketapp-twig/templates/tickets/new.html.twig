{% extends 'base.html.twig' %}

{% block title %}New Ticket{% endblock %}

{% block body %}
    <h2>Create New Ticket</h2>

    <form action="{{ path('ticket_create') }}" method="POST" class="new-ticket-form">
        
        <div class="form-group">
            <label for="title">Title (Subject)</label>
            <input type="text" id="title" name="title" required maxlength="100">
        </div>
        
        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="8" required></textarea>
        </div>

        <div class="form-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
                <option value="Low">Low</option>
                <option value="Medium" selected>Medium</option>
                <option value="High">High</option>
            </select>
        </div>

        {# Include security tokens/hidden fields as required by your framework (e.g., CSRF) #}
        {# <input type="hidden" name="csrf_token" value="..."/> #}
        
        <button type="submit" class="btn-primary">Submit Ticket</button>
    </form>
{% endblock %}